# Environment Configuration
# Copy this file to .env and fill in your values

# Database
MONGODB_URI=mongodb://localhost:27017/hardware-manager

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI (server-side only — never expose to frontend)
GEMINI_API_KEY=

# ─── Application URL (REQUIRED in production) ───────────────────────────────
# Public-facing URL for SCIM endpoints and SSO metadata.
# APP_URL=https://app.yourcompany.com

# Optional: separate API URL (falls back to APP_URL if not set)
# Used in SCIM wizard and SSO callbacks.
# API_URL=https://api.yourcompany.com

# Base domain for CSP headers (defaults to asset-node.com)
# BASE_DOMAIN=asset-node.com

# ─── Credential Encryption (REQUIRED in production) ─────────────────────────
# 32-byte hex string for AES-256-GCM encryption of stored API secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# ─── Mock Integrations (dev only) ────────────────────────────────────────────
# Set to 'true' to use MSW for all integration API calls (no real credentials)
MOCK_INTEGRATIONS=true

# ─── Transactional Email (SMTP) ──────────────────────────────────────────────
# Used for password resets, welcome emails, and notifications.
# Works with any SMTP provider (Brevo, Mailgun, AWS SES, Gmail, etc.)
# If not set, emails are logged to console only (dev mode).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-login@example.com
# SMTP_PASS=xsmtpsib-your-api-key
# SMTP_FROM=AssetNode <noreply@asset-node.com>

# ─── Maintainer / Super-Admin Notifications ──────────────────────────────────
# Receive alerts when new orgs register, users join, plans change, etc.
# Both channels are optional — configure one or both.

# Email: maintainer inbox (uses SMTP_* vars above)
# MAINTAINER_EMAIL=you@example.com

# Webhook: POST JSON payload to this URL (Slack, n8n, Make.com, custom endpoint…)
# MAINTAINER_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Google Chat: rich card notification in a Google Chat Space
# Setup: Google Chat → Open a Space → Apps & Integrations → Webhooks → Add Webhook
# MAINTAINER_GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/xxx/messages?key=yyy&token=zzz

# Optional: HMAC-SHA256 signing secret — set this so you can verify payloads on your end
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MAINTAINER_WEBHOOK_SECRET=

# ─── Billing / Qonto Direct ──────────────────────────────────────────────────
# Direct Qonto Business API v2 integration for SEPA invoice generation.
# No ElixioPay middleman — AssetNode calls Qonto directly.
# Sandbox: https://thirdparty-sandbox.staging.qonto.co/v2
# Production: https://thirdparty.qonto.com/v2
# QONTO_ENV=sandbox
# QONTO_BASE_URL=https://thirdparty-sandbox.staging.qonto.co/v2
# QONTO_API_LOGIN=your-org-slug
# QONTO_API_KEY=your-secret-key
# QONTO_STAGING_TOKEN=        # Sandbox only — OneLogin bypass token
# QONTO_ALB_COOKIE=           # Sandbox only — ALB session cookie

# ─── Marketplace — Live Product Data (optional) ─────────────────────────────
# Without these, the marketplace uses a curated static catalog (demo mode).
# Set MARKETPLACE_LIVE_DATA=true + at least one API key to enable live data.
# MARKETPLACE_LIVE_DATA=true

# TechSpecs API — 240K+ products, free tier (10 req/hr)
# Register at https://techspecs.io
# TECHSPECS_API_KEY=

# Icecat REST API — 500K+ datasheets, free (Open Icecat, 5 req/s)
# Register at https://icecat.biz (we use direct HTTP, no npm package)
# ICECAT_USERNAME=
# ICECAT_PASSWORD=

# ─── Support Ticket Bridge (GitLab) ─────────────────────────────────────────
# Support tickets submitted via the "Report issue" dialog are forwarded as
# issues to a PRIVATE GitLab project. Neither the project, the URL, nor the
# token is ever exposed to the frontend or application logs.
#
# Scope required on the token: api (issue creation only — no repo access needed).
# If any of these are missing, ticket submission falls back to MAINTAINER_EMAIL.
# SUPPORT_GITLAB_API_URL=https://gitlab.com/api/v4
# SUPPORT_GITLAB_PROJECT_ID=12345678
# SUPPORT_GITLAB_ACCESS_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
